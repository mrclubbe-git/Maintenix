# Development API only. Copy to .env; do not commit the real file.
NODE_ENV=development
HOST=127.0.0.1
PORT=5056
CORS_ORIGINS=https://mrclubbe-git.github.io
SERVER_STATUS_ENABLED=false

# Web Push optional overrides. If keys are omitted, CRA generates and persists
# its own organization-specific VAPID keypair under data/web-push-vapid.json.
VAPID_SUBJECT=https://main-tenix.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Offline access leases use a CRA-specific RSA signing keypair. When omitted,
# the API generates and persists the keypair under Server_API/CRA/data/.
# Override these paths only when runtime storage is mounted elsewhere.
OFFLINE_LEASE_PRIVATE_KEY_FILE=
OFFLINE_LEASE_PUBLIC_KEY_FILE=

# Site Logs runtime storage. Defaults to Server_API/CRA/data/site-logs and
# 60-day retention. Override only when runtime storage is mounted elsewhere.
SITE_LOG_DIR=
SITE_LOG_RETENTION_DAYS=60
