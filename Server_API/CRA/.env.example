# Development API only. Copy to .env; do not commit the real file.
NODE_ENV=development
HOST=127.0.0.1
PORT=5056
CORS_ORIGINS=https://mrclubbe-git.github.io
SERVER_STATUS_ENABLED=false

# Web Push optional overrides. If keys are omitted, CRA generates and persists
# its own organization-specific VAPID keypair under data/web-push-vapid.json.
VAPID_SUBJECT=https://main-tenix.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
